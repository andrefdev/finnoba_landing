# Demand-validation form. Set these in the Vercel project settings; copy this
# file to .env for local development. Run db/schema.sql once against the
# database before the first submission.

# Neon connection string (Vercel Marketplace -> Neon -> Connect).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string. Salts the IP hash used for rate limiting, so the
# table never holds an address that could be reversed. Changing it resets the
# rate limit; it is not used for anything else.
IP_SALT=

# Guards /admin/leads?k=... and the CSV export behind it.
ADMIN_TOKEN=

# Optional. Without these the form still stores everything, it just doesn't
# email anyone about urgent requests.
RESEND_API_KEY=
ALERT_EMAIL=jose@finnoba.xyz
