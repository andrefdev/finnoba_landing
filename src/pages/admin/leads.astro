---
import { allLeads, metrics } from "../../lib/leads";

/**
 * The phase-1 scoreboard: the six figures that decide whether we spend money
 * on the legal opinion. Reached at /admin/leads?k=<ADMIN_TOKEN>.
 *
 * ponytail: a shared token in the query string, not accounts. It guards six
 * aggregates and a CSV for two people; put it behind real auth the day anyone
 * else needs access.
 */
export const prerender = false;

const token = process.env.ADMIN_TOKEN;
const params = Astro.url.searchParams;
if (!token || params.get("k") !== token) return new Response("Not found", { status: 404 });

// ?csv=1 returns the raw rows — personal data, so it sits behind the same token.
if (params.get("csv") === "1") {
  const rows = await allLeads();
  const cols = rows.length ? Object.keys(rows[0]) : [];
  const cell = (v: unknown) => `"${String(v ?? "").replaceAll('"', '""')}"`;
  // `astro check` reports this as unused; it can't see reads that happen after
  // an early return in frontmatter. It is used on the next line.
  const csv = [cols.join(","), ...rows.map((r) => cols.map((c) => cell(r[c])).join(","))].join("\n");
  return new Response(csv, {
    headers: {
      "Content-Type": "text/csv; charset=utf-8",
      "Content-Disposition": 'attachment; filename="finnoba-leads.csv"',
    },
  });
}

const m = await metrics();

// Thresholds from the v6 spec. Green means that question is answered.
const CARDS = [
  { n: 1, label: "Cobra en dólares", value: m.pctUsd, target: 70, decides: "Si el mercado objetivo está bien definido" },
  { n: 2, label: "Orden de compra sin factura emitida", value: m.pctOrderNoInvoice, target: 40, decides: "Si el ICP pre-embarque existe de verdad" },
  { n: 3, label: "Pide entre $500 y $3K", value: m.pctSmallTicket, target: 30, decides: "Si el nivel de entrada de $500 calza con la demanda real" },
  { n: 4, label: "Su alternativa es informal o ninguna", value: m.pctInformalAlternative, target: 40, decides: "Si el pricing de 79,59% TCEA es defendible" },
  { n: 5, label: "Urgencia dentro del mes", value: m.pctUrgentWithinMonth, target: 30, decides: "Si la velocidad es realmente el diferenciador" },
  { n: 6, label: "Envíos sobre visitas al formulario", value: m.conversion, target: 25, decides: "Si el formulario es demasiado largo" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Demanda · Finnoba</title>
  </head>
  <body>
    <main>
      <h1>Validación de demanda</h1>
      <p class="counts">
        <strong>{m.submissions}</strong> envíos · <strong>{m.views}</strong> visitas al formulario
        · <a href={`?k=${token}&csv=1`}>descargar CSV</a>
      </p>

      <ol class="grid">
        {CARDS.map((c) => (
          <li class:list={["card", c.value >= c.target ? "is-green" : "is-red"]}>
            <p class="n">Métrica {c.n}</p>
            <p class="label">{c.label}</p>
            <p class="value">{c.value}%</p>
            <p class="target">Umbral: {c.target}%</p>
            <p class="decides">{c.decides}</p>
          </li>
        ))}
      </ol>

      <p class="note">
        La métrica 3 es la que puede cambiar el modelo entero: si la mayoría necesita $10.000 o más,
        el nivel de entrada de $500 no resuelve su problema. Con pocos envíos los porcentajes no
        significan nada todavía.
      </p>
    </main>
  </body>
</html>

<style>
  :root { color-scheme: light dark; }

  body {
    font-family: ui-sans-serif, system-ui, sans-serif;
    margin: 0;
    padding: 40px 24px;
    line-height: 1.5;
  }

  main { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 24px; margin: 0 0 8px; }
  .counts { margin: 0 0 28px; color: #666; font-size: 14px; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }

  .card {
    border: 1px solid #ddd;
    border-left-width: 4px;
    border-radius: 10px;
    padding: 18px;
  }

  .is-green { border-left-color: #1fb36b; }
  .is-red { border-left-color: #e5484d; }

  .n { margin: 0 0 6px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #888; }
  .label { margin: 0 0 10px; font-weight: 600; font-size: 14px; }
  .value { margin: 0; font-size: 34px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .target { margin: 2px 0 10px; font-size: 13px; color: #666; }
  .decides { margin: 0; font-size: 12.5px; color: #888; }

  .note { margin-top: 28px; font-size: 13px; color: #666; max-width: 640px; }
</style>
