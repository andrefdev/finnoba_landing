---
import Base from "../../layouts/Base.astro";
import LegalDoc from "../../components/common/LegalDoc.astro";
import { dict, localeParams, type Lang } from "../../lib/i18n";

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const l = dict(lang).legal;
---

<Base lang={lang} path="/terms" title={l.termsTitle} description={l.placeholderBody}>
  <LegalDoc title={l.termsTitle} status={l.placeholderTitle} body={l.placeholderBody} />
</Base>
