---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/common/PageHero.astro";
import Section from "../../components/common/Section.astro";
import SectionHeading from "../../components/common/SectionHeading.astro";
import Card from "../../components/common/Card.astro";
import PageCta from "../../components/common/PageCta.astro";
import { dict, localeParams, type Lang } from "../../lib/i18n";

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const th = dict(lang).thesis;
---

<Base lang={lang} path="/thesis" title={th.meta.title} description={th.meta.description}>
  <PageHero title={th.h1} subtitle={th.sub} />

  <Section topRound>
    <SectionHeading eyebrow="01" title={th.problemTitle} lead={th.problemIntro} />
    <div class="stats">
      {th.stats.map((s) => (
        <Card class="stat">
          <p class="stat-value">{s.v}</p>
          <p class="stat-label">{s.l}</p>
        </Card>
      ))}
    </div>
    <p class="footnote">{th.statsFootnote}</p>
  </Section>

  <Section paddingY="32px">
    <SectionHeading eyebrow="02" title={th.whyFailTitle} />
    <div class="stack">
      {th.whyFail.map((p) => <Card variant="rose" class="para"><p>{p}</p></Card>)}
    </div>
  </Section>

  <Section paddingY="32px">
    <SectionHeading eyebrow="03" title={th.whyFinnobaTitle} />
    <div class="stack">
      {th.whyFinnoba.map((p) => <Card variant="mint" class="para"><p>{p}</p></Card>)}
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="04" title={th.stateTitle} />
    <p class="state">{th.stateBody}</p>
  </Section>

  <PageCta lang={lang} title={th.cta} primary={th.cta} href="/investors" />
</Base>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .stat { padding: 24px; }

  .stat-value {
    font-family: var(--font);
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    margin-bottom: 10px;
  }

  .stat-label {
    font-family: var(--font);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--muted);
  }

  .footnote {
    margin-top: 18px;
    font-family: var(--font);
    font-size: 12.5px;
    color: var(--faint);
  }

  .stack { display: grid; gap: 12px; }
  .para { padding: 24px; }

  .para p,
  .state {
    font-family: var(--font);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .state { font-size: 17px; max-width: 760px; }
</style>
