---
interface Props {
  tone?: "soft" | "mint" | "sky" | "butter" | "quiet";
  class?: string;
}

const { tone = "soft", class: className } = Astro.props;
---

<span class:list={["chip", `is-${tone}`, className]}><slot /></span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    font-family: var(--font);
    font-weight: 600;
    font-size: 12px;
  }

  .is-soft {
    background: var(--white);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .is-mint { background: var(--tint-mint); color: var(--green-ink); }
  .is-sky { background: var(--tint-sky); color: #1c5bc2; }
  .is-butter { background: #fbf1d6; color: #946100; }

  /* Low-emphasis marker — used for the "illustrative example" tag. */
  .is-quiet {
    background: var(--white);
    color: var(--muted);
    font-size: 11px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
</style>
