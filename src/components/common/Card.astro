---
interface Props {
  variant?: "flat" | "glass" | "mint" | "rose" | "lilac" | "bare";
  /** Free-form background for the one-off tinted cards on the home page. */
  bg?: string;
  class?: string;
}

// `rest` carries the caller's scope attribute (data-astro-cid-*). Without
// forwarding it, a class passed in from a parent never matches the parent's
// scoped rule and the styles silently do nothing.
const { variant = "flat", bg, class: className, ...rest } = Astro.props;
---

<div
  class:list={["card", `is-${variant}`, className]}
  style={bg ? { "--card-bg": bg } : undefined}
  {...rest}
>
  <slot />
</div>

<style>
  .card {
    border-radius: var(--radius-xl);
    padding: 22px;
    background: var(--card-bg, var(--white));
  }

  .is-flat { border: 1px solid var(--line); }

  .is-glass {
    background: var(--card-bg, rgba(255, 255, 255, 0.66));
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 8px 32px rgba(16, 24, 40, 0.1);
  }

  .is-mint { background: var(--card-bg, var(--tint-mint)); }
  .is-rose { background: var(--card-bg, var(--tint-rose)); }
  .is-lilac { background: var(--card-bg, var(--tint-lilac)); }
  .is-bare { background: var(--card-bg, transparent); }
</style>
